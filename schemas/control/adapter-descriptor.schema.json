{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/control/adapter-descriptor.schema.json",
  "title": "Odin admitted adapter descriptor",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "odin.adapter.descriptor.v1" },
    "adapter": { "$ref": "#/$defs/adapter_identity" },
    "protocol_version": { "const": 1 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/operation_contract" }
    },
    "credential_handles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/credential_handle" }
    },
    "initial_taint": { "$ref": "#/$defs/taint" }
  },
  "required": [
    "schema",
    "adapter",
    "protocol_version",
    "operations",
    "credential_handles",
    "initial_taint"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,191}$"
    },
    "schema_ref": {
      "type": "string",
      "pattern": "^schemas/[a-zA-Z0-9._/-]+\\.json$"
    },
    "adapter_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter_id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "binding_digest": { "type": "string", "pattern": "^blake3:[0-9a-f]{64}$" }
      },
      "required": ["adapter_id", "version", "binding_digest"]
    },
    "credential_handle": {
      "type": "string",
      "pattern": "^cred:[a-zA-Z0-9][a-zA-Z0-9._:-]{0,190}$"
    },
    "taint": {
      "type": "string",
      "enum": ["clean", "credential_tainted"]
    },
    "evidence_requirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "$ref": "#/$defs/id" },
        "schema": { "$ref": "#/$defs/schema_ref" },
        "required": { "type": "boolean" }
      },
      "required": ["kind", "schema", "required"]
    },
    "operation_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$" },
        "input_schema": { "$ref": "#/$defs/schema_ref" },
        "output_schema": { "$ref": "#/$defs/schema_ref" },
        "effect_class": { "type": "string", "enum": ["R0", "R1", "R2", "R3"] },
        "idempotency": { "type": "string", "enum": ["pure", "required"] },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidence_requirement" }
        },
        "credential_handle": {
          "oneOf": [
            { "$ref": "#/$defs/credential_handle" },
            { "type": "null" }
          ]
        },
        "taint_after": { "$ref": "#/$defs/taint" }
      },
      "required": [
        "kind",
        "input_schema",
        "output_schema",
        "effect_class",
        "idempotency",
        "evidence",
        "credential_handle",
        "taint_after"
      ]
    }
  }
}
