{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://odin.local/schemas/capability/knowledge.read.input.json",
  "title": "knowledge.read input",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "section": {
      "type": "string",
      "maxLength": 200
    },
    "cite": {
