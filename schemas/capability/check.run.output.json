{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/capability/check.run.output.json",
  "title": "check.run output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "log": {
      "type": "string"
    },
    "seconds": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "ok",
    "outputs",
    "log",
    "seconds"
  ]
}
