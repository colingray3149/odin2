      "enum": [
        "pending",
        "firing",
        "fired",
        "cancelled"
      ]
    },
    "anchor": {
      "type": [
        "string",
        "null"
      ]
    },
    "repeat": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "text",
    "kind",
    "fireAt",
    "status",
    "anchor",
    "repeat"
  ]
