{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/capability/desktop.display.input.json",
  "title": "desktop.display input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "device": { "type": "string", "minLength": 1, "description": "Desktop friendly name, or all for every declared desktop. Omitted uses the declared conversation desktop." },
    "on": { "type": "boolean", "description": "Monitors on (true) or off (false)." }
  },
  "required": ["on"]
}
