{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://odin.local/schemas/capability/web.read.output.json",
  "title": "web.read output",
  "description": "An MCP tools/call result: the content blocks and, when the server returns one, its structured content.",
  "properties": {
    "content": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object"
      }
    },
    "structuredContent": {
      "type": "object"
    }
  },
  "required": [
    "content"
  ]
}
