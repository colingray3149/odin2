{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/capability/task.pause.output.json",
  "title": "task.pause output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "child": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "before": {
      "type": "string"
    },
    "applied": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcome": {
      "type": "string"
    }
  },
  "required": [
    "child",
    "before",
    "applied",
    "outcome"
  ]
}
