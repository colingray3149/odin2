{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/capability/git.branch.merge.input.json",
  "title": "git.branch.merge input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^seat/[a-z0-9-]+/[a-z0-9-]+$"
    },
    "expectedBase": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "expectedHead": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "approvalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "project",
    "branch",
    "expectedBase",
    "expectedHead"
  ]
}
