{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://odin.local/schemas/capability/knowledge.dig.input.json",
  "title": "knowledge.dig input",
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "scope": {
      "type": "string",
      "enum": [
        "mail",
        "chats",
        "docs",
        "ai",
        "library",
        "odin",
        "web",
        "all"
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "since": {
      "type": "string",
      "maxLength": 10
    },
    "until": {
      "type": "string",
      "maxLength": 10
    },
    "path": {
      "type": "string",
      "maxLength": 300
    },
    "case": {
      "type": "string",
      "enum": [
        "insensitive",
        "sensitive"
      ],
      "description": "insensitive (default) or sensitive: 'DoMINO' then matches neither 'domino' nor 'Domino'."
    },
    "word": {
      "type": "boolean",
      "description": "Match whole words only."
    },
    "source": {
      "type": "string",
      "enum": [
        "raw",
        "index",
        "both"
      ],
      "description": "raw (default): ripgrep over the files, a parsed PDF's hit names the PDF; index: BM25 over the parsed reference text (papers, manuals, library), ranked, about a second; both."
    }
  },
  "required": [
    "query"
  ]
}
