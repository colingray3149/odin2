{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/capability/intake.read.input.json",
  "title": "intake.read input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "intake": {
      "type": "string",
      "minLength": 3,
      "maxLength": 26,
      "pattern": "^[1-9][0-9]{0,19}/[1-9][0-9]{0,4}$"
    }
  },
  "required": [
    "intake"
  ]
}
