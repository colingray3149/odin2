{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/capability/artifact.read.output.json",
  "title": "artifact.read output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artifactId": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0
    },
    "mediaType": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "base64": {
      "type": "string"
    }
  },
  "required": [
    "artifactId",
    "sizeBytes",
    "mediaType"
  ]
}
