{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/capability/registry.edit.input.json",
  "title": "registry.edit input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "workload",
        "seat",
        "lane",
        "project",
        "node",
        "context-profile"
      ],
      "description": "The kind of the existing declaration to change."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Its id, e.g. kubert-odin or scribe."
    },
    "set": {
      "type": "object",
      "maxProperties": 16,
      "description": "Keys to set, dotted for a table: {\"limits.pods\": 8} or {\"resources.memory\": \"3Gi\"}.",
      "propertyNames": {
        "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+){0,3}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 512
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "array",
            "maxItems": 64,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 256
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          }
        ]
      }
    },
    "add": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+){0,3}$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "description": "Items to add to a list: {\"read_project_scope\": [\"example-project\"]}."
    },
    "remove": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+){0,3}$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "description": "Items to remove from a list."
    },
    "unset": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+){0,3}$"
      },
      "description": "Keys to remove entirely, dotted for a table."
    },
    "personal": {
      "type": "boolean",
      "description": "Mark added lines as personal for the owner's life, accounts or private projects."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "Why, in a few words; it goes in the commit."
    },
    "approvalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "kind",
    "id",
    "reason"
  ],
  "anyOf": [
    {
      "required": [
        "set"
      ]
    },
    {
      "required": [
        "add"
      ]
    },
    {
      "required": [
        "remove"
      ]
    },
    {
      "required": [
        "unset"
      ]
    }
  ]
}
