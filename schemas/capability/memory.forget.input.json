{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/capability/memory.forget.input.json",
  "title": "memory.forget input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contains": {
      "type": "string",
      "minLength": 6,
      "maxLength": 500,
      "description": "Exact case-sensitive token or phrase identifying one memory; ambiguous matches are listed and refused."
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "page": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 6,
      "maxLength": 500
    }
  },
  "oneOf": [
    {
      "required": ["contains"],
      "not": {"anyOf": [
        {"required": ["commit"]},
        {"required": ["page"]},
        {"required": ["label"]}
      ]}
    },
    {
      "required": ["commit", "page", "label"],
      "not": {"required": ["contains"]}
    }
  ]
}
