{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://odin.local/schemas/capability/brain.search.output.json",
  "title": "brain.search output",
  "properties": {
    "policyDigest": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "registryRevision": {
      "type": "integer",
      "minimum": 1
    },
    "posture": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "full"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "lexicalOnly"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "mode",
            "reason"
          ]
        }
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^brain://"
          },
          "source": {
            "type": "string"
          },
          "trust": {
            "type": "string"
          },
          "score": {
            "type": "integer"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "source",
          "trust",
          "score",
          "content"
        ]
      }
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "policyDigest",
    "registryRevision",
    "posture",
    "results",
    "truncated"
  ]
}
