{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/capability/task.steer.input.json",
  "title": "task.steer input",
  "description": "Redirect a delegated worker: mid-task when it is working, otherwise as the instruction it continues with. Only the delegating parent may steer its worker.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "childSession": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "required": [
    "childSession",
    "message"
  ]
}
