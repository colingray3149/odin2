{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/capability/artifact.read.input.json",
  "title": "artifact.read input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artifactId": {
      "type": "string",
      "pattern": "^(blake3:[0-9a-f]{64}|artifact:[0-9a-f-]{36}:[0-9a-f]{64})$"
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "description": "Byte offset of the page."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 262144,
      "description": "Maximum bytes in this page; defaults to 4096."
    }
  },
  "required": [
    "artifactId"
  ]
}
