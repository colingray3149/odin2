{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/capability/reminder.list.output.json",
  "title": "reminder.list output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "now": {
      "type": "string"
    },
    "reminders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "notify",
              "wake"
            ]
          },
          "fireAt": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "firing",
              "fired",
              "cancelled"
            ]
          },
          "anchor": {
            "type": [
              "string",
              "null"
            ]
          },
          "repeat": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "text",
          "kind",
          "fireAt",
          "status",
          "anchor",
          "repeat"
        ]
      }
    }
  },
  "required": [
    "now",
    "reminders"
  ]
}
