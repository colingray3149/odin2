{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://odin.local/schemas/capability/journal.read.input.json",
  "title": "journal.read input",
  "properties": {
    "lines": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "since": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "level": {
      "type": "string",
      "enum": ["error", "warn", "info"]
    }
  }
}
