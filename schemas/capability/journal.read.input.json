{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://odin.local/schemas/capability/journal.read.input.json",
  "title": "journal.read input",
  "properties": {
    "unit": {
      "description": "The authority's user unit to read; default odind.",
      "type": "string",
      "enum": [
        "odind",
        "brain-load",
        "brain-reduce",
        "brain-commit",
        "brain-google-pull",
        "brain-grow",
        "brain-inventory",
        "brain-archive-refresh",
        "brain-rerank",
        "media-mirror",
        "local-models",
        "hub-embedding",
        "hub-embedding-proxy",
        "whisper-server",
        "litellm",
        "litellm-node",
        "omp-auth-broker",
        "omp-auth-gateway",
        "odin-models-refresh"
      ]
    },
    "lines": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "since": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "level": {
      "type": "string",
      "enum": ["error", "warn", "info"]
    }
  }
}
