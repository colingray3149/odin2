{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/capability/calendar.propose.input.json",
  "title": "calendar.propose input",
  "description": "Two-phase human-gated calendar mutation for the calendar.propose operation. The `account` selector names one configured life calendar account explicitly and travels with every request; the payload carries exactly one mutation tagged `type` — `create` (title/start/end plus optional location and description), `move` (eventId/start/end), `cancel` (eventId), or `batchCreate` (1..128 concrete drafts) — with variant names and field spellings exactly as the adapter's serde. Phase one (no approvalId) requests the exact-scope approval in the ledger approval gate; nothing mutates, and the proposal is recorded as a durable intent at execution, from the consumed permit's exact arguments. Phase two supplies approvalId: a model-supplied selector naming the exact approval, never itself authority — the kernel dispatch consumes that exact approval server-side, and the host executor passes the unforgeable authorized-operation proof into effect execution, which the adapter verifies against the durable gate record before the transport runs. A denial is recorded durably with its evidence reference and no mutation. Times are absolute RFC 3339 instants; end must be after start, the span is at most 366 days and whole seconds, title is bounded at 200, location at 512, and description at 2000 Unicode scalar values, exactly the adapter's enforced bounds. Recurrence is never invented and no variant can destroy an event. Credential material never travels in arguments. The command is keyed by the operation's idempotency key (CORE-004): replayed mutations deduplicate.",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "const": "create"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "start": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "end": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "location": {
          "type": "string",
          "maxLength": 512
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "approvalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "account",
        "type",
        "title",
        "start",
        "end"
      ]
    },
    {
