{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/capability/intake.copy.output.json",
  "title": "intake.copy output",
  "description": "Where the copy is: its host, root, path in the root and size.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "host": { "type": "string" },
    "root": { "type": "string" },
    "path": { "type": "string", "minLength": 1 },
    "sizeBytes": { "type": "integer", "minimum": 0 }
  },
  "required": ["host", "root", "path", "sizeBytes"]
}
