{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/capability/kube.snapshot.read.output.json",
  "title": "kube.snapshot.read output",
  "description": "Pure read of the bound run's live workload truth. status ok carries the odin.kube.job-projection.v1 wire projection (or null when the run has no cluster workload yet); unavailable carries a typed reason. Never mutates cluster state.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "unavailable"
      ]
    },
    "projection": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lane": { "type": "string" },
          "windowDays": { "type": "integer", "minimum": 1 },
          "coreHours": { "$ref": "#/$defs/budget" },
          "gpuHours": { "$ref": "#/$defs/budget" },
          "computeUsd": { "$ref": "#/$defs/budget" }
        },
        "required": ["lane", "windowDays", "coreHours", "gpuHours", "computeUsd"]
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  },
  "required": [
    "status"
  ],
  "$defs": {
    "budget": {
      "type": "object", "additionalProperties": false,
      "properties": { "used": { "type": "number", "minimum": 0 }, "cap": { "type": ["integer", "null"], "minimum": 1 } },
      "required": ["used", "cap"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "projection"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unavailable"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    }
  ]
}
