{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/capability/files.list.output.json",
  "title": "files.list output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "root": { "type": "string" },
          "host": { "type": ["string", "null"] },
          "name": { "type": "string" }
        },
        "required": ["root", "host", "name"]
      }
    },
    "root": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "kind": { "type": "string" },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "mediaType": { "type": ["string", "null"] },
          "modifiedAt": { "type": ["string", "null"] }
        },
        "required": ["path", "kind", "sizeBytes", "mediaType", "modifiedAt"]
      }
    }
  }
}
