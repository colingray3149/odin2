{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/capability/code.review.verdict.input.json",
  "title": "code.review.verdict input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "diffDigest": {
      "type": "string",
      "minLength": 8,
      "maxLength": 80
    },
    "approve": {
      "type": "boolean"
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "required": [
    "diffDigest",
    "approve",
    "notes"
  ]
}
