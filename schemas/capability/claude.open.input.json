{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "Open a declared Claude workload. A declared preset opens that preset's placement, driver, directory, and permission settings; an unsandboxed preset creates no worktree or branch. Ordinary workload publication is restricted to the immutable resolved project and refs/heads/claude/<name> under the original kernel lease.",
  "properties": {
    "preset": { "type": "string", "minLength": 1, "maxLength": 64 },
    "dir": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "skip_permissions": {
      "type": "boolean",
      "description": "Override the declared permission choice; default on for pod, off for host-tab. Resolved choice is recorded on the session."
    },
    "account": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "placement": {
      "type": "string",
      "enum": [
        "pod",
        "host-tab"
      ],
      "default": "pod"
    },
    "mcp": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "if": { "required": ["preset"] },
  "else": { "required": ["account", "project"], "not": { "required": ["dir"] } },
  "additionalProperties": false
}
