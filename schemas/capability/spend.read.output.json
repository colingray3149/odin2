{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://odin.local/schemas/capability/spend.read.output.json",
  "title": "spend.read output",
  "properties": {
    "seats": { "type": "array", "items": { "allOf": [ { "$ref": "#/$defs/tagCost" }, { "required": ["seat"] } ] } },
    "workloads": { "type": "array", "items": { "allOf": [ { "$ref": "#/$defs/tagCost" }, { "required": ["workload"] } ] } },
    "compute": { "description": "Compute spend (leases, offload runs), apart from the model total; each row names its source.", "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": { "label": { "type": "string" }, "usd": { "type": "number", "minimum": 0 }, "source": { "type": "string" } }, "required": ["label", "usd", "source"] } },
    "sessions": { "type": "array", "items": { "allOf": [ { "$ref": "#/$defs/tagCost" }, { "required": ["session"] } ] } },
    "untagged_usd": { "type": "number", "minimum": 0 },
    "attribution_error": { "type": "string" },
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "total": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "usd": {
          "type": "number",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "requests": {
          "type": "integer",
          "minimum": 0
        },
        "included_usd": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "usd",
        "tokens",
        "requests",
        "included_usd"
      ]
    },
    "days": {
      "type": "array",
      "maxItems": 62,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "usd": {
            "type": "number",
            "minimum": 0
          },
          "tokens": {
            "type": "integer",
            "minimum": 0
          },
          "requests": {
            "type": "integer",
            "minimum": 0
          },
          "date": {
            "type": [
              "string",
              "null"
            ]
          },
          "included_usd": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "usd",
          "tokens",
          "requests",
          "date",
          "included_usd"
        ]
      }
    },
    "lanes": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "usd": {
            "type": "number",
            "minimum": 0
          },
          "tokens": {
            "type": "integer",
            "minimum": 0
          },
          "requests": {
            "type": "integer",
            "minimum": 0
          },
          "lane": {
            "type": "string"
          },
          "included_usd": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "usd",
          "tokens",
          "requests",
          "lane",
          "included_usd"
        ]
      }
    },
    "note": {
      "type": "string"
    }
  },
  "$defs": {
    "tagCost": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "usd": { "type": "number", "minimum": 0 },
        "included_usd": { "type": "number", "minimum": 0 },
        "tokens": { "type": "integer", "minimum": 0 },
        "requests": { "type": "integer", "minimum": 0 },
        "seat": { "type": "string" },
        "workload": { "type": "string" },
        "session": { "type": "string" }
      },
      "required": ["usd", "included_usd", "tokens", "requests"]
    }
  },
  "required": [
    "from",
    "to",
    "total",
    "days",
    "lanes",
    "note"
  ]
}
