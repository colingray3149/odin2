{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/capability/registry.author.input.json",
  "title": "registry.author input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "skeleton": {
      "enum": [
        "new-lane",
        "new-alert",
        "new-surface"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "values": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    }
  },
  "required": [
    "skeleton",
    "id",
    "values"
  ]
}
