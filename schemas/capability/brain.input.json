{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/capability/brain.input.json",
  "title": "brain input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "op": {
      "type": "string",
      "enum": [
        "records",
        "person",
        "fact",
        "asset",
        "photo",
        "project",
        "place",
        "status"
      ],
      "x-op-descriptions": {
        "records": "Find curated records by text and structured filters.",
        "person": "Find a person by identity or a known detail.",
        "fact": "Read a fact by its id.",
        "asset": "Find a tracked physical asset.",
        "photo": "Read one photo or its evidence.",
        "project": "Read a project by id or name.",
        "place": "Find a Discord server or channel.",
        "status": "Read curated record ingestion status."
      }
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "person: slug, name or a word of it, other spelling, handle, email, phone or photo person id; fact: fact id; photo: exact asset path from a result; project: projects.toml id or name; place: Discord server name or id, or a channel id, name or server/channel"
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "unit",
            "fact",
            "person",
            "photo",
            "doc"
          ]
        },
        "person": {
          "type": "string",
          "maxLength": 256
        },
        "source": {
          "type": "string",
          "maxLength": 64,
          "description": "discord, snapchat, instagram, chat"
        },
        "topic": {
          "type": "string",
          "maxLength": 128
        },
        "from": {
          "type": "string",
          "description": "YYYY, YYYY-MM or YYYY-MM-DD"
        },
        "to": {
          "type": "string",
          "description": "YYYY, YYYY-MM or YYYY-MM-DD"
        },
        "near": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lat": {
              "type": "number"
            },
            "lon": {
              "type": "number"
            },
            "km": {
              "type": "number"
            }
          },
          "required": [
            "lat",
            "lon",
            "km"
          ]
        }
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  },
  "required": [
    "op"
  ]
}
