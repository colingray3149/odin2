{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/capability/odin.plan_set.input.json",
  "title": "odin.plan_set input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "objective": { "type": "string" },
    "todos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pending", "active", "blocked", "completed", "cancelled"] }
        },
        "required": ["id", "title", "status"]
      }
    },
    "expectedRevision": { "type": "integer", "minimum": 0 },
    "timestampMs": { "type": "integer" }
  },
  "required": ["objective", "todos", "expectedRevision", "timestampMs"]
}
