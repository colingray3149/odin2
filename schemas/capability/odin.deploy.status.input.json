{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://odin.local/schemas/capability/odin.deploy.status.input.json",
  "title": "odin.deploy.status input",
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "wait": {
      "type": "boolean"
    }
  },
  "required": [
    "project"
  ]
}
