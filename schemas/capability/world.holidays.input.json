{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/capability/world.holidays.input.json",
  "title": "world.holidays input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "country": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2,
      "description": "ISO country code; default US."
    },
    "year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100,
      "description": "A whole year; omitted lists the next few."
    }
  }
}
