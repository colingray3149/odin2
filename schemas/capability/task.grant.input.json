{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/capability/task.grant.input.json",
  "title": "task.grant input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "object",
            "not": {"required": ["approvalId"]}
          }
        },
        "required": ["capability", "arguments"]
      }
    },
    "minutes": {
      "type": "integer",
      "minimum": 1
    },
    "max_uses": {
      "type": "integer",
      "minimum": 1
    },
    "approvalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "task",
    "effects",
    "minutes",
    "max_uses"
  ]
}
