{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/capability/fleet.drain.output.json",
  "title": "fleet.drain output",
  "description": "The typed drain outcome. `result` is `drained` when the host's nodes were really cordoned and their drainable pods evicted or reported, or `authority-move-plan` when the host holds the registry's authoritative state — then `plan` carries the ordered operator-runbook steps and the declared standby candidates; the authority's node is only cordoned. In both cases `workloads` says what happened to each running Odin pod first: rehomed with its state to a node its declared placement fits, or paused until the host is restored. Pods still present at the deadline are reported in `remained`, never an error.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "workloads": {
      "type": "array",
      "items": { "type": "string" }
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "node": {
      "type": "string",
      "minLength": 1,
      "description": "The drained node, or the authoritative node when the answer is the move plan."
    },
    "result": {
      "type": "string",
      "enum": ["drained", "authority-move-plan"]
    },
    "cordoned": {
      "type": "boolean"
    },
    "evicted": {
      "type": "array",
      "items": { "type": "string" }
    },
    "remained": {
      "type": "array",
      "items": { "type": "string" }
    },
    "authorityHolds": {
      "type": "boolean"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "step": { "type": "integer", "minimum": 1 },
              "description": { "type": "string", "minLength": 1 },
              "command": { "type": "string" },
              "facts": { "type": "object" }
            },
            "required": ["step", "description"]
          }
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "node": { "type": "string", "minLength": 1 },
              "host": { "type": "string", "minLength": 1 }
            },
            "required": ["node", "host"]
          }
        },
        "note": { "type": "string", "minLength": 1 }
      },
      "required": ["steps", "candidates", "note"]
    }
  },
  "required": ["host", "node", "result", "cordoned", "evicted", "remained", "authorityHolds"]
}
