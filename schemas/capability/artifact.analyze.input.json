{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/capability/artifact.analyze.input.json",
  "title": "artifact.analyze input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(blake3:[0-9a-f]{64}|artifact:[0-9a-f-]{36}:[0-9a-f]{64})$"
    },
    "program": {
      "type": "array",
      "minItems": 1,
      "description": "Absolute program and its arguments. `{artifact}` is the staged read-only path.",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "artifactId",
    "program"
  ]
}
