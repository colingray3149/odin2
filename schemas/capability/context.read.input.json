{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odin.local/schemas/capability/context.read.input.json",
  "title": "context.read input",
  "description": "One bounded UTF-8 read beneath the host-provisioned operator context root. The root is never caller-controlled or exposed.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    }
  },
  "required": ["path", "maxBytes"]
}
