  "title": "knowledge.add input",
  "properties": {
    "text": {
      "type": "string",
      "maxLength": 200000
    },
    "path": {
      "type": "string",
      "maxLength": 1000
    },
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "as": {
      "type": "string",
      "enum": [
        "file",
        "note"
      ]
    },
    "project": {
      "type": "string",
      "maxLength": 100
    },
    "session": {
      "type": "string",
      "maxLength": 100
    }
  },
  "required": []
}
