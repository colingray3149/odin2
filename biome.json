{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "view/main.ts",
      "view/src/**",
      "view/test/**",
      "view/dev/**/*.ts",
      "extension/*.ts"
    ]
  },
  "javascript": {
    "globals": ["Bun"]
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "correctness": {
        "noUnusedVariables": "error",
        "noUndeclaredVariables": "error"
      },
      "suspicious": {
        "noDebugger": "error",
        "noDoubleEquals": "error"
      }
    }
  }
}
